.     local keep_vars numpanh mes_12 conglome_12 vivienda_12 hogar_12 ubigeo_12
>  dominio_12 estrato_12 factor07_12

.     foreach v in p101_12 p105a_12 tipenc_12 fecent_12 result_12 panel_12 peri
> odo_12 {
  2.         capture confirm variable `v'
  3.         if _rc == 0 {
  4.             local keep_vars `keep_vars' `v'
  5.         }
  6.     }

.     foreach prefix in hpan hpanel fac_panel facpanel {
  2.         capture ds `prefix'*
  3.         if _rc == 0 {
  4.             local keep_vars `keep_vars' `r(varlist)'
  5.         }
  6.     }

.     local keep_vars: list uniq keep_vars

